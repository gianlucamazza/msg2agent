---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import SignupForm from '@/components/pricing/SignupForm';
import { SITE_URL } from '@/site.config.ts';
---
<MarketingLayout
  title="Get API Key — msg2agent"
  description="Self-serve signup on your self-hosted msg2agent instance. Free tier with no credit card required."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "msg2agent",
    "description": "Self-hosted agent-to-agent messaging relay with W3C DID identity.",
    "url": `${SITE_URL}/pricing`,
    "offers": [
      { "@type": "Offer", "name": "Free", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
      { "@type": "Offer", "name": "Starter", "price": "19", "priceCurrency": "USD", "billingIncrement": "P1M" },
      { "@type": "Offer", "name": "Team", "price": "99", "priceCurrency": "USD", "billingIncrement": "P1M" }
    ]
  })} />

  <div class="pricing-wrap">
    <h1>Get your API key</h1>
    <p class="subtitle">Signup on this instance — free tier requires no credit card. Run your own relay to use these forms.</p>

    <SignupForm client:load />

    <div class="enterprise-cta">
      <strong>Questions</strong> — project contact, not a hosted sales desk.
      <a href="mailto:info@gianlucamazza.it?subject=msg2agent">info@gianlucamazza.it →</a>
    </div>
  </div>
</MarketingLayout>
